# ------------------------------------------------------------------
# .env.local の雛形
#
# 使い方:
#   1. このファイルを「.env.local」という名前でコピーする
#   2. 下の「★ここに入力」の箇所を、Firebase コンソールの値で置き換える
#   3. .env.local は Git に入れない（.gitignore の *.local で除外済み）
#
# このファイル（.env.local.example）には実際の値を書かないこと。
# ------------------------------------------------------------------

# --- Firebase Web アプリの設定値 ---
# 取得場所: Firebase コンソール → プロジェクトの設定 → 全般 → マイアプリ → SDK の設定と構成
# ★ここに入力: apiKey
VITE_FIREBASE_API_KEY=
# ★ここに入力: authDomain（例: <プロジェクトID>.firebaseapp.com）
VITE_FIREBASE_AUTH_DOMAIN=
# ★ここに入力: projectId
VITE_FIREBASE_PROJECT_ID=
# ★ここに入力: appId
VITE_FIREBASE_APP_ID=
# ★ここに入力: messagingSenderId
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Google ログイン用のクライアント ID ---
# 取得場所: Firebase コンソール → Authentication → ログイン方法 → Google
#           →「ウェブ SDK 構成」→「ウェブ クライアント ID」
# ★ここに入力: 例 VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# 空のままでも動くが、その場合はポップアップ方式だけになり、iPhone でログインに失敗することがある。
# あわせて、Google Cloud コンソールで「承認済みのリダイレクト URI」の登録が必要（README 参照）。
VITE_GOOGLE_CLIENT_ID=

# --- 読み書きを許可する Google アカウントの UID（父・母の2つ） ---
# 取得場所: アプリで Google ログインした後に表示される「あなたの UID」
# カンマ区切りで2つ。空白は入れない。
# ★ここに入力: 例 VITE_ALLOWED_UIDS=AbCdEf...,GhIjKl...
# 記入後に「npm run rules」を実行すると firestore.rules が生成される。
VITE_ALLOWED_UIDS=
